def cmd_apk_info(a):
    r = subprocess.run([sys.executable, os.path.join(TOOLS, "apk.py"), "info", a.apk] +
                       (["--json"] if a.json else []))
    return r.returncode


def cmd_apk_install(a):
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    if not os.path.isdir(rootfs):
        raise Fail("rootfs not built")
    with zipfile.ZipFile(a.apk) as z:
        has_arm64 = any(n.startswith("lib/arm64-v8a/") for n in z.namelist())
    if not has_arm64:
        print("note: APK has no arm64-v8a native code; it runs entirely on ART (still fine)")
    need_root("installing into the guest")
    tmpdir = os.path.join(rootfs, "data/local/tmp")
    os.makedirs(tmpdir, exist_ok=True)
    dest = os.path.join(tmpdir, os.path.basename(a.apk))
    shutil.copy2(a.apk, dest)
    guest_path = "/data/local/tmp/" + os.path.basename(a.apk)
    return enter_guest(rootfs, ["/system/bin/pm", "install", "-r", "-g", guest_path])


def cmd_apk_start(a):
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    need_root("launching an app")
    if a.activity:
        argv = ["/system/bin/am", "start", "-n", "%s/%s" % (a.package, a.activity)]
    else:
        argv = ["/system/bin/monkey", "-p", a.package, "-c",
                "android.intent.category.LAUNCHER", "1"]
    return enter_guest(rootfs, argv)


def cmd_apk_list(a):
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    return enter_guest(rootfs, ["/system/bin/cmd", "package", "list", "packages"])


# --------------------------------------------------------------------------
# boot / logs / stop
# --------------------------------------------------------------------------
def cmd_boot(a):
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    if not os.path.isdir(rootfs):
        raise Fail("rootfs not built")
    if a.dry_run:
        return subprocess.call(["sh", os.path.join(SCRIPTS, "30-boot.sh"), rootfs, a.mode,
                                "--dry-run"])
    need_root("booting the guest")
    logdir = os.path.join(HOME_DIR, "logs")
    os.makedirs(logdir, exist_ok=True)
    log = open(os.path.join(logdir, "boot.log"), "ab")
    p = subprocess.Popen(["sh", os.path.join(SCRIPTS, "30-boot.sh"), rootfs, a.mode],
                         stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    with open(os.path.join(HOME_DIR, "guest.pid"), "w") as f:
        f.write(str(p.pid))
    print("guest booting as pid %d (%s mode), logs: %s"
          % (p.pid, a.mode, os.path.join(logdir, "boot.log")))
    print("  qandroid logs -f        follow boot log")
    print("  qandroid apk install X  install an APK")
    return 0


def cmd_logs(a):
    p = os.path.join(HOME_DIR, "logs", "boot.log")
    if not os.path.exists(p):
        raise Fail("no log yet (boot the guest first)")
    if a.follow:
        r = subprocess.Popen(["tail", "-n", str(a.lines), "-F", p])
        try:
            return r.wait()
        except KeyboardInterrupt:
            r.terminate()
            return 0
    with open(p, "r", errors="replace") as f:
        lines = f.readlines()
    sys.stdout.write("".join(lines[-a.lines:]))
    return 0


def cmd_stop(a):
    pidfile = os.path.join(HOME_DIR, "guest.pid")
    if not os.path.exists(pidfile):
        print("guest not running")
        return 0
    pid = int(open(pidfile).read().strip())
    try:
        os.killpg(pid, 15)
        print("sent SIGTERM to guest process group %d" % pid)
    except ProcessLookupError:
        print("guest already gone")
    os.unlink(pidfile)
    return 0


def cmd_display(a):
    """Run the HWC2 client. The socket lives inside the rootfs (the guest's
    /data/local/tmp), so the host path is derived from the rootfs rather than
    from the guest-visible path."""
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    client = os.path.join(HERE, "frontend", "hwc_client")
    if not os.path.exists(client):
        raise Fail("host client not built: run `make client` (needs libsdl2-dev)")
    sockdir = os.path.join(rootfs, "data", "local", "tmp")
    os.makedirs(sockdir, exist_ok=True)
    sock = os.path.join(sockdir, "qandroid-hwc.sock")
    argv = [client, "--socket", sock] + a.extra
    print("+ %s" % " ".join(argv))
    return subprocess.call(argv)


def cmd_viewer(a):
    return subprocess.call([sys.executable, os.path.join(HERE, "frontend", "viewer.py"),
                            "--root", a.root or load_cfg()["rootfs"]] + a.extra)


# --------------------------------------------------------------------------
def main(argv):
    ap = argparse.ArgumentParser(prog="qandroid", description=__doc__.splitlines()[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor")

    pi = sub.add_parser("image")
    pi_sub = pi.add_subparsers(dest="sub", required=True)
    pl = pi_sub.add_parser("list")
    pl.add_argument("--abi", default="arm64")
    pl.add_argument("--variant")
    pl.add_argument("--limit", type=int, default=8)
    pl.add_argument("--json", action="store_true")
    pf = pi_sub.add_parser("fetch")
    pf.add_argument("--abi", default="arm64")
    pf.add_argument("--variant", default="VANILLA")
    pf.add_argument("--url")
    pf.add_argument("--force", action="store_true")
    pf.add_argument("--no-unpack", action="store_true")

    pr = sub.add_parser("rootfs")
    pr_sub = pr.add_subparsers(dest="sub", required=True)
    pb = pr_sub.add_parser("build")
    pb.add_argument("--image-dir")
    pb.add_argument("--out")
    pb.add_argument("--dry-run", action="store_true")
    ps = pr_sub.add_parser("shell")
    ps.add_argument("--root")
    ps.add_argument("--dry-run", action="store_true")
    ps.add_argument("args", nargs=argparse.REMAINDER)

    pa = sub.add_parser("apk")
    pa_sub = pa.add_subparsers(dest="sub", required=True)
    pai = pa_sub.add_parser("info")
    pai.add_argument("apk")
    pai.add_argument("--json", action="store_true")
    pax = pa_sub.add_parser("install")
    pax.add_argument("apk")
    pax.add_argument("--root")
    pas = pa_sub.add_parser("start")
    pas.add_argument("package")
    pas.add_argument("--activity")
    pas.add_argument("--root")
    pal = pa_sub.add_parser("list")
    pal.add_argument("--root")

    pb2 = sub.add_parser("boot")
    pb2.add_argument("--root")
    pb2.add_argument("--mode", choices=["init", "manual"], default="init")
    pb2.add_argument("--dry-run", action="store_true")
    sub.add_parser("stop").add_argument("--root", nargs="?")
    lg = sub.add_parser("logs")
    lg.add_argument("--lines", type=int, default=100)
    lg.add_argument("-f", "--follow", action="store_true")
    pdl = sub.add_parser("display")
    pdl.add_argument("--root")
    pdl.add_argument("extra", nargs=argparse.REMAINDER)
    pv = sub.add_parser("viewer")
    pv.add_argument("--root")
    pv.add_argument("extra", nargs=argparse.REMAINDER)

    a = ap.parse_args(argv)
    try:
        if a.cmd == "doctor":
            return cmd_doctor(a)
        if a.cmd == "image":
            return cmd_image_list(a) if a.sub == "list" else cmd_image_fetch(a)
        if a.cmd == "rootfs":
            return cmd_rootfs_build(a) if a.sub == "build" else cmd_rootfs_shell(a)
        if a.cmd == "apk":
            if a.sub == "info":
                return cmd_apk_info(a)
            if a.sub == "install":
                return cmd_apk_install(a)
            if a.sub == "start":
                return cmd_apk_start(a)
            return cmd_apk_list(a)
        if a.cmd == "boot":
            return cmd_boot(a)
        if a.cmd == "logs":
            return cmd_logs(a)
        if a.cmd == "stop":
            return cmd_stop(a)
        if a.cmd == "display":
            return cmd_display(a)
        if a.cmd == "viewer":
            return cmd_viewer(a)
    except Fail as e:
        print("qandroid: %s" % e, file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as e:
        print("qandroid: command failed: %s" % e, file=sys.stderr)
        return 1
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
