#!/usr/bin/env python3
"""qandroid - run arm64 Android APKs on x86_64 Linux.

Architecture: the host kernel provides the boring, arch-independent half of the
Android ABI (binderfs, memfd, ashmem-compatible shared memory, futexes, namespaces)
and qemu-aarch64-user provides instruction translation.  On top of that sits an
unmodified arm64 Android userspace (LineageOS/Waydroid 20 arm64 image), so
bionic, libhwbinder, ART and SurfaceFlinger are the real Apple-of-Android code -
no reimplementation of the Android runtime, no proprietary translator.

Native arm64 code in the APK therefore executes natively in the guest's own ABI;
only the instruction set is translated.  That is the whole compatibility layer.

Subcommands:
  doctor            check host prerequisites
  image list        newest arm64 images from the Waydroid mirror
  image fetch       download + unpack an arm64 system image
  rootfs build      turn system.img/vendor.img into a chroot rootfs
  rootfs shell      enter the guest shell (QEMU + binfmt)
  apk info|libs     inspect an APK offline
  apk install       install an APK into the guest
  boot              start the guest Android userspace
  logs              tail guest logs
  stop              stop the guest
  setup             fetch an image and build the rootfs (first run)
  display           HWC2 client: guest SurfaceFlinger → host window (SDL2)
  viewer            screencap-based fallback frontend
"""
import argparse
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import hashlib
import tarfile
import zipfile
import urllib.request

# realpath, not abspath: the packaged entry point is a symlink from /usr/bin
HERE = os.path.dirname(os.path.realpath(__file__))
TOOLS = os.path.join(HERE, "tools")
SCRIPTS = os.path.join(HERE, "scripts")
VERSION = "0.3.0"
HOME_DIR = os.environ.get("QANDROID_HOME", os.path.expanduser("~/.local/share/qandroid"))
# one feed for both partitions; the vendor images live under /images/vendor/
RSS = "https://sourceforge.net/projects/waydroid/rss?path=/images"
QEMU = os.environ.get("QANDROID_QEMU", "qemu-aarch64-static")


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------
class Fail(Exception):
    pass


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def need_root(what):
    if os.geteuid() != 0 and not os.environ.get("QANDROID_FAKE_ROOT"):
        raise Fail("%s needs root (uid 0); re-run with sudo, or use --dry-run to print the plan" % what)


def human(n):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return "%.1f %s" % (n, unit)
        n /= 1024.0


def load_cfg():
    p = os.path.join(HOME_DIR, "config.json")
    if os.path.exists(p):
        with open(p) as f:
            return json.load(f)
    return {"rootfs": os.path.join(HOME_DIR, "rootfs"), "images": os.path.join(HOME_DIR, "images")}


def save_cfg(cfg):
    os.makedirs(HOME_DIR, exist_ok=True)
    with open(os.path.join(HOME_DIR, "config.json"), "w") as f:
        json.dump(cfg, f, indent=2)


def build_helpers(quiet=False):
    """Compile the host-side helpers that the guest paths need.

    A .deb built without a compiler on the build host ships sources only, so the
    binaries are built on first use. Nothing here needs more than cc.
    """
    needed = []
    for name in ("binder-mk", "binder-ver"):
        if not os.path.exists(os.path.join(TOOLS, name)):
            needed.append(name)
    if not needed:
        return True
    cc = shutil.which(os.environ.get("CC", "cc"))
    if not cc:
        print("qandroid: no C compiler available; install build-essential", file=sys.stderr)
        return False
    for name in needed:
        src = os.path.join(TOOLS, name + ".c")
        out = os.path.join(TOOLS, name)
        if not os.path.exists(src):
            continue
        r = run([cc, "-O2", "-Wall", "-o", out, src])
        if r.returncode:
            print("qandroid: building %s failed: %s" % (name, (r.stderr or "").strip()), file=sys.stderr)
            return False
        if not quiet:
            print("built %s" % out)
    return True


def du(path):
    total = 0
    for base, _dirs, files in os.walk(path):
        for f in files:
            fp = os.path.join(base, f)
            if not os.path.islink(fp):
                total += os.path.getsize(fp)
    return total


# --------------------------------------------------------------------------
# doctor
# --------------------------------------------------------------------------
def probe_binfmt():
    """Any enabled entry whose magic matches arm64 ELFs counts - the distro
    package and our own registration use different names."""
    base = "/proc/sys/fs/binfmt_misc"
    if not os.path.isdir(base):
        return None
    try:
        names = os.listdir(base)
    except OSError:
        return None
    found = []
    for n in names:
        if n in ("register", "status"):
            continue
        try:
            with open(os.path.join(base, n)) as f:
                txt = f.read()
        except OSError:
            continue
        if "enabled" in txt and ("aarch64" in n or "aarch64" in txt):
            interp = [l.split(None, 1)[1].strip() for l in txt.splitlines()
                      if l.startswith("interpreter ")]
            found.append("%s -> %s" % (n, interp[0] if interp else "?"))
    return "; ".join(found) if found else None


def kernel_version():
    v = os.uname().release
    m = re.match(r"(\d+)\.(\d+)", v)
    return (int(m.group(1)), int(m.group(2))) if m else (0, 0)


def probe_kernel(feature):
    """Ask the running kernel what it supports. Reads files directly: no grep,
    no shell, nothing that can block on a procfs oddity."""
    if feature == "binderfs":
        try:
            with open("/proc/filesystems") as f:
                fs = f.read()
        except OSError:
            fs = ""
        if "binderfs" in fs:
            return "yes"
        return "yes (already mounted)" if os.path.isdir("/dev/binderfs") else "no"
    if feature == "ashmem":
        return "yes" if os.path.exists("/dev/ashmem") else "no (Android 12+ images do not need it)"
    if feature == "memfd":
        return "yes (kernel >= 3.17)" if kernel_version() >= (3, 17) else "no (kernel too old)"
    if feature == "kvm":
        return "yes" if os.path.exists("/dev/kvm") else "no"
    return "unknown"


def cmd_doctor(a):
    cfg = load_cfg()
    arch = os.uname().machine
    rows = [
        ("host arch", arch, arch in ("x86_64", "amd64")),
        ("page size", str(os.sysconf("SC_PAGE_SIZE")), True),
        ("python", sys.version.split()[0], sys.version_info >= (3, 8)),
        ("qemu aarch64 user", shutil.which(QEMU) or "MISSING", bool(shutil.which(QEMU))),
        ("kernel version", ".".join(map(str, kernel_version()[:2])), kernel_version() >= (4, 11)),
        ("binfmt_misc aarch64", probe_binfmt() or "not registered", bool(probe_binfmt())),
        ("kernel: binderfs", probe_kernel("binderfs"), "yes" in probe_kernel("binderfs")),
        ("kernel: memfd_create", probe_kernel("memfd"), "yes" in probe_kernel("memfd")),
        ("kernel: /dev/ashmem", probe_kernel("ashmem"), None),
        ("kernel: kvm (irrelevant here)", probe_kernel("kvm"), None),
        ("debugfs (ext4 extract)", shutil.which("debugfs") or "MISSING", bool(shutil.which("debugfs"))),
        ("sudo/root", "yes" if os.geteuid() == 0 else "no", os.geteuid() == 0),
        ("rootfs", cfg["rootfs"] if os.path.exists(cfg["rootfs"]) else "not built", None),
    ]
    width = max(len(r[0]) for r in rows)
    hard_ok = True
    for name, val, ok in rows:
        mark = "ok  " if ok else ("WARN" if ok is None else "FAIL")
        if ok is False:
            hard_ok = False
        print("%s %-*s  %s" % (mark, width, name, val))
    if not hard_ok:
        print("\nfailures above block the guest from starting; see docs/LIMITS.md")
        return 1
    return 0


# --------------------------------------------------------------------------
# image handling
# --------------------------------------------------------------------------
def parse_rss(xml):
    out = []
    for body in re.findall(r"<item>(.*?)</item>", xml, re.S):
        title = re.search(r"<title>(.*?)</title>", body, re.S)
        link = re.search(r"<link>(.*?)</link>", body, re.S)
        size = re.search(r'filesize="(\d+)"', body)
        md5 = re.search(r'<media:hash algo="md5">([0-9a-f]{32})', body)
        if not (title and link):
            continue
        path = title.group(1).strip("<![CDATA[").strip("]]>").strip()
        out.append({
            "path": path,
            "name": os.path.basename(path),
            "url": link.group(1).strip(),
            "size": int(size.group(1)) if size else None,
            "md5": md5.group(1) if md5 else None,
        })
    return out


def rss_items(limit=40):
    with urllib.request.urlopen(RSS, timeout=30) as r:
        xml = r.read().decode("utf-8", "replace")
    return parse_rss(xml)[:limit]


def cmd_image_list(a):
    items = [i for i in rss_items(400) if i["path"].endswith(".zip") and "/images/system/" in i["path"]]
    if a.abi:
        items = [i for i in items if ("waydroid_%s" % a.abi) in i["path"]]
    if a.variant:
        items = [i for i in items if ("-%s-" % a.variant.upper()) in i["name"]]
    seen, rows = set(), []
    for i in items:
        key = i["path"].rsplit("/", 1)[0]
        if key in seen:
            continue
        seen.add(key)
        rows.append(i)
    rows = rows[: a.limit]
    if a.json:
        print(json.dumps(rows, indent=2))
        return 0
    for i in rows:
        print("%-72s %10s" % (i["name"], human(i["size"]) if i["size"] else "?"))
        print("   %s" % i["url"])
    return 0


def pick_vendor(abi, match_date=None):
    """Waydroid ships the vendor partition separately; without it SurfaceFlinger
    and netd cannot link (vendor.waydroid.display, libnetd_updatable)."""
    items = [i for i in rss_items(400)
             if "/images/vendor/waydroid_%s/" % abi in i["path"] and i["name"].endswith(".zip")]
    if not items:
        return None
    if match_date:
        # prefer the build that matches the system image; a vendor partition from
        # a different build week links against different HAL versions
        same = [i for i in items if match_date in i["name"]]
        if same:
            return same[0]
    mainline = [i for i in items if "-MAINLINE-" in i["name"]]
    pool = mainline or items
    pool.sort(key=lambda i: re.findall(r"(\d{8})", i["name"]) or ["0"], reverse=True)
    return pool[0]


def pick_image(abi, variant):
    items = [i for i in rss_items(400) if i["path"].endswith(".zip") and "/images/system/" in i["path"]]
    cand = [i for i in items if ("waydroid_%s/" % abi) in i["path"]
            and "-%s-" % variant.upper() in i["name"]]
    if not cand:
        raise Fail("no %s/%s image found on the mirror" % (abi, variant))
    # newest by date embedded in filename
    cand.sort(key=lambda i: re.findall(r"(\d{8})", i["name"]) or ["0"], reverse=True)
    return cand[0]


def md5_of(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def download(url, dest, expected=None):
    """curl if available (resumable, retried, mirror-redirect aware), else urllib.

    A single-sourceforge-stream download via urllib is what stalled a CI
    bring-up for 25 minutes; curl with --continue-at resumes across a dropped
    mirror connection instead of starting the 870 MiB over."""
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + ".part"
    print("fetching %s" % url)
    curl = shutil.which("curl")
    if curl:
        args = [curl, "-L", "--fail", "--retry", "5", "--retry-delay", "3",
                "--retry-all-errors", "--connect-timeout", "30",
                "--speed-time", "60", "--speed-limit", "10240",
                "-C", "-", "-o", tmp, url]
        print("+ %s" % " ".join(args[:-1] + ["<url>"]))
        r = subprocess.run(args)
        if r.returncode != 0 or not os.path.exists(tmp):
            raise Fail("curl failed with status %s" % r.returncode)
        os.replace(tmp, dest)
        h = hashlib.sha256()
        with open(dest, "rb") as f:
            for b in iter(lambda: f.read(1 << 20), b""):
                h.update(b)
        print("sha256 %s" % h.hexdigest())
        if expected:
            got = md5_of(dest)
            print("md5    %s %s" % (got, "ok" if got == expected else "MISMATCH (mirror said %s)" % expected))
        return dest
    with urllib.request.urlopen(url, timeout=60) as r, open(tmp, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        done = 0
        while True:
            chunk = r.read(1 << 20)
            if not chunk:
                break
            f.write(chunk)
            done += len(chunk)
            if total:
                sys.stderr.write("\r  %5.1f%%  %s / %s" % (100.0 * done / total, human(done), human(total)))
            else:
                sys.stderr.write("\r  %s" % human(done))
    sys.stderr.write("\n")
    os.replace(tmp, dest)
    h = hashlib.sha256()
    with open(dest, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    digest = h.hexdigest()
    print("sha256 %s" % digest)
    if expected:
        got = md5_of(dest)
        print("md5    %s %s" % (got, "ok" if got == expected else "MISMATCH (mirror said %s)" % expected))
    return dest


def cmd_image_fetch(a):
    cfg = load_cfg()
    if a.url:
        info = {"url": a.url, "name": os.path.basename(a.url.split("?")[0])}
    else:
        info = pick_image(a.abi, a.variant)
        print("selected %s" % info["name"])
    dest = os.path.join(cfg["images"], info["name"])
    blobs = [info]
    if not a.no_vendor:
        dates = re.findall(r"(\d{8})", info["name"])
        vendor = pick_vendor(a.abi, dates[0] if dates else None)
        if vendor:
            print("vendor image: %s" % vendor["name"])
            blobs.append(vendor)
        else:
            print("warning: no vendor image on the mirror for abi=%s" % a.abi)
    for blob in blobs:
        path = os.path.join(cfg["images"], blob["name"])
        if os.path.exists(path) and not a.force:
            print("already present: %s" % path)
        else:
            download(blob["url"], path, expected=blob.get("md5"))
    if a.no_unpack:
        return 0
    out = os.path.join(cfg["images"], os.path.splitext(info["name"])[0])
    os.makedirs(out, exist_ok=True)
    with zipfile.ZipFile(dest) as z:
        names = z.namelist()
        print("archive contains: %s" % ", ".join(names))
        for n in names:
            if n.endswith((".img", ".img.sparse", ".tar", ".tar.gz", ".xz")):
                z.extract(n, out)
    # vendor lands in the same image dir so rootfs build finds system.img + vendor.img
    for blob in blobs[1:]:
        with zipfile.ZipFile(os.path.join(cfg["images"], blob["name"])) as z:
            for n in z.namelist():
                if n.endswith(".img"):
                    z.extract(n, out)
                    print("vendor payload: %s" % n)
    for base, _d, files in os.walk(out):
        for f in files:
            print("%-50s %10s" % (os.path.join(base, f), human(os.path.getsize(os.path.join(base, f)))))
    cfg["last_image"] = out
    save_cfg(cfg)
    return 0


# --------------------------------------------------------------------------
# rootfs
# --------------------------------------------------------------------------
def ext4_root_entries(img):
    """Names in the image's root directory. One debugfs call, no recursion.

    `ls -p` is the portable form (e2fsprogs has no `ls -1`): each entry is
    "/<inode>/<mode>/<uid>/<gid>/<name>/<target>/", so the name is field 5."""
    r = run(["debugfs", "-R", "ls -p /", img])
    names = set()
    for line in (r.stdout or "").splitlines():
        line = line.strip()
        if not line or line.startswith("debugfs") or line.startswith("***"):
            continue
        if line.startswith("/"):
            parts = line.split("/")
            if len(parts) >= 6 and parts[5]:
                names.add(parts[5])
        else:  # fallback for plain-name output
            names.add(line.lstrip("/").split("/")[0])
    names.discard(".")
    names.discard("..")
    return names


def ensure_raw_image(img):
    """Android sparse images (magic 0x3AFF26ED) need expansion before debugfs.
    Returns the path to a raw ext4 image."""
    with open(img, "rb") as f:
        head = f.read(4)
    if len(head) < 4 or struct.unpack("<I", head)[0] != 0x3AFF26ED:
        return img
    out = os.path.splitext(img)[0] + ".raw.img"
    if os.path.exists(out) and os.path.getsize(out) > 0:
        return out
    tool = shutil.which("simg2img")
    if not tool:
        raise Fail("%s is a sparse image and simg2img is missing "
                   "(apt install android-sdk-libsparse-utils)" % img)
    print("expanding sparse image -> %s" % out)
    with open(out, "wb") as dst:
        r = subprocess.run([tool, img, "-"], stdout=dst)
    if r.returncode:
        raise Fail("simg2img failed")
    return out


def guest_resolve(rootfs, path):
    """Resolve a guest-absolute path inside rootfs, following symlinks that are
    absolute *in the guest's namespace* (Android images are full of them:
    /bin -> /system/bin, /etc -> /system/etc). Returns a host path or None."""
    parts = [p for p in path.split("/") if p and p != "."]
    cur = ""
    hops = 0
    while parts:
        seg = parts.pop(0)
        if seg == "..":
            cur = os.path.dirname(cur)
            continue
        cur = os.path.join(cur, seg)
        full = os.path.join(rootfs, cur)
        if not os.path.lexists(full):
            return None
        if os.path.islink(full):
            if hops > 32:
                return None
            hops += 1
            target = os.readlink(full)
            if not target.startswith("/"):
                cur = os.path.dirname(cur)   # relative to the link's directory
            else:
                cur = ""
            parts = [p for p in target.split("/") if p and p != "."] + parts
    return os.path.join(rootfs, cur)


def guest_lstat(rootfs, path):
    """Like guest_resolve, but does not follow the final component.

    Needed because Android 12+ ships /system/bin/linker64 as a symlink into
    /apex/com.android.runtime, which only exists once init has mounted the APEX
    files at boot. Treating that as missing would be wrong."""
    parent, name = os.path.split(path.rstrip("/"))
    hp = guest_resolve(rootfs, parent or "/")
    if hp is None:
        return None
    full = os.path.join(hp, name)
    return full if os.path.lexists(full) else None


def ext4_extract(img, dest, dry=False):
    """Unprivileged ext4 extraction via debugfs rdump (no loop mount, no root)."""
    cmd = ["debugfs", "-R", "rdump / %s" % dest, img]
    print("+ %s" % " ".join(cmd))
    if dry:
        return
    if not shutil.which("debugfs"):
        raise Fail("debugfs is required (apt install e2fsprogs)")
    os.makedirs(dest, exist_ok=True)
    r = run(cmd)
    if r.returncode not in (0, 1) and "not a directory" not in (r.stderr or ""):
        raise Fail("debugfs failed: %s" % (r.stderr or r.stdout))
    # debugfs refuses to overwrite existing files; that is fine for a fresh dir


def cmd_rootfs_build(a):
    cfg = load_cfg()
    src = a.image_dir or cfg.get("last_image")
    if not src or not os.path.isdir(src):
        raise Fail("give --image-dir (a directory holding system.img / vendor.img / super.img)")
    rootfs = a.out or cfg["rootfs"]
    os.makedirs(rootfs, exist_ok=True)

    system = os.path.join(src, "system.img")
    vendor = os.path.join(src, "vendor.img")
    superimg = os.path.join(src, "super.img")

    if os.path.exists(superimg) and not (os.path.exists(system) and os.path.exists(vendor)):
        lp = os.path.join(TOOLS, "lpunpack.py")
        raw = os.path.join(src, "unpacked")
        print("unpacking logical partitions from super.img")
        subprocess.run([sys.executable, lp, "extract", superimg, raw, "--quiet"], check=True)
        for name in ("system", "vendor", "product"):
            for variant in (os.path.join(raw, name + ".img"), os.path.join(raw, name + "_a.img")):
                if os.path.exists(variant):
                    dest = os.path.join(src, name + ".img")
                    if not os.path.exists(dest):
                        os.link(variant, dest)
                    break
        system, vendor = os.path.join(src, "system.img"), os.path.join(src, "vendor.img")

    if not os.path.exists(system):
        raise Fail("no system.img in %s" % src)

    system = ensure_raw_image(system)
    entries = set() if a.dry_run else ext4_root_entries(system)

    # Android 10+ images are system-as-root: the image *is* the guest root and
    # carries its own /bin -> /system/bin style links.  Older images are a bare
    # /system partition and have to be nested.
    system_as_root = (not a.dry_run) and "system" in entries and "bin" in entries
    if a.dry_run:
        print("  (dry run: image layout not probed)")
    print("image layout: %s" % ("system-as-root" if system_as_root else "system partition"))

    dest = rootfs if system_as_root else os.path.join(rootfs, "system")
    print("extracting %s -> %s" % (os.path.basename(system), dest))
    ext4_extract(system, dest, dry=a.dry_run)

    if os.path.exists(vendor):
        vendor = ensure_raw_image(vendor)
        print("extracting vendor.img -> %s/vendor" % rootfs)
        ext4_extract(vendor, os.path.join(rootfs, "vendor"), dry=a.dry_run)

    if not system_as_root:
        for link, target in [("bin", "system/bin"), ("lib64", "system/lib64"),
                             ("lib", "system/lib"), ("etc", "system/etc"),
                             ("apex", "system/apex"), ("vendor", "system/vendor")]:
            if a.dry_run:
                continue
            p = os.path.join(rootfs, link)
            if os.path.lexists(p) or not os.path.isdir(os.path.join(rootfs, target)):
                continue
            os.symlink(target, p)

    if not a.dry_run:
        # The image already provides most of these - often as guest-absolute
        # symlinks (/sdcard -> /storage/self/primary) that dangle on the host,
        # so lexists() (not follows) decides, and a failure is a note not a
        # traceback.
        for d in ("data", "data/local/tmp", "data/app", "dev", "proc", "sys", "tmp",
                  "mnt", "sdcard", "metadata"):
            target = os.path.join(rootfs, d)
            if os.path.lexists(target):
                continue
            try:
                os.makedirs(target, exist_ok=True)
            except OSError as e:
                print("  note: %s not created (%s) - image layout already covers it"
                      % (d, e.strerror))
        tmpdir = guest_resolve(rootfs, "/tmp")
        try:
            if tmpdir and os.path.isdir(tmpdir):
                os.chmod(tmpdir, 0o1777)
        except OSError:
            pass
        with open(os.path.join(rootfs, ".qandroid-rootfs"), "w") as f:
            f.write("built from %s\n" % os.path.abspath(src))

        # sanity: the pieces init and the linker actually need
        checks = ["/system/bin/init", "/system/bin/linker64", "/system/bin/sh",
                  "/system/bin/app_process64", "/system/build.prop"]
        missing = []
        for c in checks:
            hit = guest_resolve(rootfs, c)
            if hit:
                print("  %-28s ok" % c)
                continue
            if guest_lstat(rootfs, c):
                print("  %-28s ok (via APEX, mounted at boot)" % c)
                continue
            print("  %-28s MISSING" % c)
            missing.append(c)
        if missing:
            print("warning: %d expected guest path(s) missing; the image may need its "
                  "vendor partition too" % len(missing))

    print("rootfs %s: %s, %d top-level entries" % (rootfs, human(du(rootfs)), len(os.listdir(rootfs))))
    return 0


def guest_env():
    env = {"TERM": os.environ.get("TERM", "xterm")}
    env.update(GUEST_ENV)
    return env


def bind_mounts(rootfs, dry=False):
    """Mounts the guest expects. Host kernel does these; the guest just uses them."""
    plan = [
        (["mount", "-t", "proc", "proc", os.path.join(rootfs, "proc")], "proc"),
        (["mount", "--rbind", "/sys", os.path.join(rootfs, "sys")], "sys"),
        (["mount", "--rbind", "/dev", os.path.join(rootfs, "dev")], "dev"),
        (["mount", "-t", "tmpfs", "tmp", os.path.join(rootfs, "dev/shm")], "dev/shm"),
    ]
    binderfs = os.path.join(rootfs, "dev/binderfs")
    os.makedirs(binderfs, exist_ok=True)
    plan.append((["mount", "-t", "binder", "binder", binderfs], "binderfs"))
    mk = os.path.join(TOOLS, "binder-mk")
    for name in ("binder", "hwbinder", "vndbinder"):
        node = os.path.join(binderfs, name)
        plan.append(([mk, binderfs, name], "node " + name))
        tgt = os.path.join(rootfs, "dev", name)
        plan.append((["mount", "--bind", node, tgt], "bind " + name))
    for cmd, label in plan:
        print("  + %s" % " ".join(cmd))
        if not dry:
            r = run(cmd)
            if r.returncode:
                print("    ! %s: %s" % (label, (r.stderr or "").strip()))


def enter_guest(rootfs, argv, dry=False):
    """Exec an arm64 guest binary.

    With binfmt_misc registered the kernel picks qemu-aarch64-static up
    transparently, so a plain chroot is enough.  Without it we call qemu by hand,
    which also works but does not compose with setuid/namespace tricks.
    """
    qemu = shutil.which(QEMU)
    if dry:
        print("+ chroot %s %s   (dry run)" % (rootfs, " ".join(argv)))
        return 0
    if probe_binfmt():
        cmd = ["chroot", rootfs] + argv
    elif qemu:
        cmd = [qemu, "-L", rootfs, "-cpu", "max", "--"] + argv
    else:
        raise Fail("neither binfmt_misc aarch64 nor qemu-aarch64-static available "
                   "(run scripts/00-deps.sh)")
    print("+ %s" % " ".join(cmd))
    return subprocess.call(cmd, env=guest_env())


def cmd_rootfs_shell(a):
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    if not os.path.isdir(rootfs):
        raise Fail("rootfs not built: %s" % rootfs)
    argv = [c for c in (getattr(a, "args", []) or []) if c != "--"]
    if not a.dry_run:
        need_root("chroot")
        bind_mounts(rootfs)
    return enter_guest(rootfs, argv or ["/system/bin/sh"], dry=a.dry_run)


# --------------------------------------------------------------------------
# apk
# --------------------------------------------------------------------------
def cmd_apk_info(a):
    r = subprocess.run([sys.executable, os.path.join(TOOLS, "apk.py"), "info", a.apk] +
                       (["--json"] if a.json else []))
    return r.returncode


def cmd_apk_install(a):
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    if not os.path.isdir(rootfs):
        raise Fail("rootfs not built")
    with zipfile.ZipFile(a.apk) as z:
        has_arm64 = any(n.startswith("lib/arm64-v8a/") for n in z.namelist())
    if not has_arm64:
        print("note: APK has no arm64-v8a native code; it runs entirely on ART (still fine)")
    need_root("installing into the guest")
    tmpdir = os.path.join(rootfs, "data/local/tmp")
    os.makedirs(tmpdir, exist_ok=True)
    dest = os.path.join(tmpdir, os.path.basename(a.apk))
    shutil.copy2(a.apk, dest)
    guest_path = "/data/local/tmp/" + os.path.basename(a.apk)
    return enter_guest(rootfs, ["/system/bin/pm", "install", "-r", "-g", guest_path])


def cmd_apk_start(a):
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    need_root("launching an app")
    if a.activity:
        argv = ["/system/bin/am", "start", "-n", "%s/%s" % (a.package, a.activity)]
    else:
        argv = ["/system/bin/monkey", "-p", a.package, "-c",
                "android.intent.category.LAUNCHER", "1"]
    return enter_guest(rootfs, argv)


def cmd_apk_list(a):
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    return enter_guest(rootfs, ["/system/bin/cmd", "package", "list", "packages"])


# --------------------------------------------------------------------------
# boot / logs / stop
# --------------------------------------------------------------------------
def cmd_boot(a):
    if not a.dry_run and not build_helpers(quiet=True):
        raise Fail("host helpers missing and could not be built")
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    if not os.path.isdir(rootfs):
        raise Fail("rootfs not built")
    if a.dry_run:
        return subprocess.call(["sh", os.path.join(SCRIPTS, "30-boot.sh"), rootfs, a.mode,
                                "--dry-run"])
    need_root("booting the guest")
    logdir = os.path.join(HOME_DIR, "logs")
    os.makedirs(logdir, exist_ok=True)
    log = open(os.path.join(logdir, "boot.log"), "ab")
    p = subprocess.Popen(["sh", os.path.join(SCRIPTS, "30-boot.sh"), rootfs, a.mode],
                         stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    with open(os.path.join(HOME_DIR, "guest.pid"), "w") as f:
        f.write(str(p.pid))
    print("guest booting as pid %d (%s mode), logs: %s"
          % (p.pid, a.mode, os.path.join(logdir, "boot.log")))
    print("  qandroid logs -f        follow boot log")
    print("  qandroid apk install X  install an APK")
    return 0


def cmd_logs(a):
    p = os.path.join(HOME_DIR, "logs", "boot.log")
    if not os.path.exists(p):
        raise Fail("no log yet (boot the guest first)")
    if a.follow:
        r = subprocess.Popen(["tail", "-n", str(a.lines), "-F", p])
        try:
            return r.wait()
        except KeyboardInterrupt:
            r.terminate()
            return 0
    with open(p, "r", errors="replace") as f:
        lines = f.readlines()
    sys.stdout.write("".join(lines[-a.lines:]))
    return 0


def cmd_stop(a):
    pidfile = os.path.join(HOME_DIR, "guest.pid")
    if not os.path.exists(pidfile):
        print("guest not running")
        return 0
    pid = int(open(pidfile).read().strip())
    try:
        os.killpg(pid, 15)
        print("sent SIGTERM to guest process group %d" % pid)
    except ProcessLookupError:
        print("guest already gone")
    os.unlink(pidfile)
    return 0


def cmd_display(a):
    """Run the HWC2 client. The socket lives inside the rootfs (the guest's
    /data/local/tmp), so the host path is derived from the rootfs rather than
    from the guest-visible path."""
    cfg = load_cfg()
    rootfs = a.root or cfg["rootfs"]
    client = os.path.join(HERE, "frontend", "hwc_client")
    if not os.path.exists(client):
        src = os.path.join(HERE, "frontend", "hwc_client.c")
        cc = shutil.which(os.environ.get("CC", "cc"))
        pkg = shutil.which("pkg-config")
        if cc and pkg and os.path.exists(src):
            flags = run([pkg, "--cflags", "--libs", "sdl2"])
            if flags.returncode == 0:
                print("building the display client (SDL2 found)")
                r = run([cc, "-O2", "-Wall", "-o", client, src,
                         "-I" + os.path.join(HERE, "hwc", "include")] + flags.stdout.split())
                if r.returncode != 0:
                    raise Fail("building hwc_client failed: %s" % (r.stderr or "").strip())
        if not os.path.exists(client):
            raise Fail("host client not built and SDL2 headers are missing "
                       "(apt install libsdl2-dev, then run `make client`)")
    sockdir = os.path.join(rootfs, "data", "local", "tmp")
    os.makedirs(sockdir, exist_ok=True)
    sock = os.path.join(sockdir, "qandroid-hwc.sock")
    argv = [client, "--socket", sock] + a.extra
    print("+ %s" % " ".join(argv))
    return subprocess.call(argv)


def cmd_setup(a):
    """One-shot: check the host, fetch an image, build the rootfs."""
    cfg = load_cfg()
    print("== host check ==")
    cmd_doctor(a)
    print("\n== image ==")
    fetch_args = argparse.Namespace(abi=a.abi, variant=a.variant, url=None,
                                    force=False, no_unpack=False, no_vendor=False)
    cmd_image_fetch(fetch_args)
    print("\n== rootfs ==")
    build_args = argparse.Namespace(image_dir=None, out=a.root, dry_run=False)
    rc = cmd_rootfs_build(build_args)
    if rc == 0:
        print("\nnext: sudo qandroid boot   (then: qandroid display)")
    return rc


def cmd_viewer(a):
    return subprocess.call([sys.executable, os.path.join(HERE, "frontend", "viewer.py"),
                            "--root", a.root or load_cfg()["rootfs"]] + a.extra)


# --------------------------------------------------------------------------
def main(argv):
    ap = argparse.ArgumentParser(prog="qandroid", description=__doc__.splitlines()[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__)
    ap.add_argument("--version", action="version", version="qandroid " + VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor")

    pi = sub.add_parser("image")
    pi_sub = pi.add_subparsers(dest="sub", required=True)
    pl = pi_sub.add_parser("list")
    pl.add_argument("--abi", default="arm64")
    pl.add_argument("--variant")
    pl.add_argument("--limit", type=int, default=8)
    pl.add_argument("--json", action="store_true")
    pf = pi_sub.add_parser("fetch")
    pf.add_argument("--abi", default="arm64")
    pf.add_argument("--variant", default="VANILLA")
    pf.add_argument("--url")
    pf.add_argument("--force", action="store_true")
    pf.add_argument("--no-unpack", action="store_true")
    pf.add_argument("--no-vendor", action="store_true",
                    help="skip the separate vendor partition image")

    pr = sub.add_parser("rootfs")
    pr_sub = pr.add_subparsers(dest="sub", required=True)
    pb = pr_sub.add_parser("build")
    pb.add_argument("--image-dir")
    pb.add_argument("--out")
    pb.add_argument("--dry-run", action="store_true")
    ps = pr_sub.add_parser("shell")
    ps.add_argument("--root")
    ps.add_argument("--dry-run", action="store_true")
    ps.add_argument("args", nargs=argparse.REMAINDER)

    pa = sub.add_parser("apk")
    pa_sub = pa.add_subparsers(dest="sub", required=True)
    pai = pa_sub.add_parser("info")
    pai.add_argument("apk")
    pai.add_argument("--json", action="store_true")
    pax = pa_sub.add_parser("install")
    pax.add_argument("apk")
    pax.add_argument("--root")
    pas = pa_sub.add_parser("start")
    pas.add_argument("package")
    pas.add_argument("--activity")
    pas.add_argument("--root")
    pal = pa_sub.add_parser("list")
    pal.add_argument("--root")

    pb2 = sub.add_parser("boot")
    pb2.add_argument("--root")
    pb2.add_argument("--mode", choices=["init", "manual"], default="init")
    pb2.add_argument("--dry-run", action="store_true")
    sub.add_parser("stop").add_argument("--root", nargs="?")
    lg = sub.add_parser("logs")
    lg.add_argument("--lines", type=int, default=100)
    lg.add_argument("-f", "--follow", action="store_true")
    psu = sub.add_parser("setup", help="fetch an image and build the rootfs")
    psu.add_argument("--abi", default="arm64")
    psu.add_argument("--variant", default="VANILLA")
    psu.add_argument("--root")

    pdl = sub.add_parser("display")
    pdl.add_argument("--root")
    pdl.add_argument("extra", nargs=argparse.REMAINDER)
    pv = sub.add_parser("viewer")
    pv.add_argument("--root")
    pv.add_argument("extra", nargs=argparse.REMAINDER)

    a = ap.parse_args(argv)
    try:
        if a.cmd == "doctor":
            return cmd_doctor(a)
        if a.cmd == "image":
            return cmd_image_list(a) if a.sub == "list" else cmd_image_fetch(a)
        if a.cmd == "rootfs":
            return cmd_rootfs_build(a) if a.sub == "build" else cmd_rootfs_shell(a)
        if a.cmd == "apk":
            if a.sub == "info":
                return cmd_apk_info(a)
            if a.sub == "install":
                return cmd_apk_install(a)
            if a.sub == "start":
                return cmd_apk_start(a)
            return cmd_apk_list(a)
        if a.cmd == "boot":
            return cmd_boot(a)
        if a.cmd == "logs":
            return cmd_logs(a)
        if a.cmd == "stop":
            return cmd_stop(a)
        if a.cmd == "setup":
            return cmd_setup(a)
        if a.cmd == "display":
            return cmd_display(a)
        if a.cmd == "viewer":
            return cmd_viewer(a)
    except Fail as e:
        print("qandroid: %s" % e, file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as e:
        print("qandroid: command failed: %s" % e, file=sys.stderr)
        return 1
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
